COMPOSE_PROJECT_NAME=eickrono_autenticacao_hml

# Configuracoes do PostgreSQL por servico
KEYCLOAK_POSTGRES_HOST=host.docker.internal
KEYCLOAK_POSTGRES_PORT=5432
KEYCLOAK_POSTGRES_DB=keycloak_hml
KEYCLOAK_POSTGRES_USER=keycloak_hml
KEYCLOAK_POSTGRES_PASSWORD=senhaKeycloakHml

AUTENTICACAO_POSTGRES_HOST=host.docker.internal
AUTENTICACAO_POSTGRES_PORT=5432
AUTENTICACAO_POSTGRES_DB=eickrono_autenticacao_hml
AUTENTICACAO_POSTGRES_USER=eickrono_hml
AUTENTICACAO_POSTGRES_PASSWORD=senhaSuperSeguraHml

IDENTIDADE_POSTGRES_HOST=host.docker.internal
IDENTIDADE_POSTGRES_PORT=5432
IDENTIDADE_POSTGRES_DB=eickrono_identidade_hml
IDENTIDADE_POSTGRES_USER=eickrono_hml
IDENTIDADE_POSTGRES_PASSWORD=senhaSuperSeguraHml
IDENTIDADE_AVATAR_STORAGE_TIPO=local
IDENTIDADE_AVATAR_STORAGE_BUCKET=avatares-hml
IDENTIDADE_AVATAR_STORAGE_DIRETORIO=/var/lib/eickrono/avatares
IDENTIDADE_AVATAR_STORAGE_PUBLIC_URL_BASE=http://localhost:19084/identidade/avatares/publicos
INTEGRACAO_PERFIL_DISPONIBILIDADE_URL_BASE=http://eickrono-autenticacao:8081

CONTAS_POSTGRES_HOST=host.docker.internal
CONTAS_POSTGRES_PORT=5432
CONTAS_POSTGRES_DB=eickrono_contas_hml
CONTAS_POSTGRES_USER=eickrono_hml
CONTAS_POSTGRES_PASSWORD=senhaSuperSeguraHml

# Configuracoes do Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_PROXY=edge
KEYCLOAK_FEATURES=instagram-broker
EICKRONO_PASSWORD_PEPPER=pepperHMLTrocar
KEYCLOAK_FRONTEND_URL=http://localhost:19080

KEYCLOAK_IDP_THIMISU_GOOGLE_CLIENT_ID=trocar-google-client-id
KEYCLOAK_IDP_THIMISU_GOOGLE_CLIENT_SECRET=trocar-google-client-secret
KEYCLOAK_IDP_THIMISU_APPLE_CLIENT_ID=trocar-apple-client-id
KEYCLOAK_IDP_THIMISU_APPLE_CLIENT_SECRET_JWT=trocar-apple-client-secret-jwt
KEYCLOAK_IDP_THIMISU_FACEBOOK_APP_ID=trocar-facebook-app-id
KEYCLOAK_IDP_THIMISU_FACEBOOK_APP_SECRET=trocar-facebook-app-secret
KEYCLOAK_IDP_THIMISU_LINKEDIN_CLIENT_ID=trocar-linkedin-client-id
KEYCLOAK_IDP_THIMISU_LINKEDIN_CLIENT_SECRET=trocar-linkedin-client-secret
KEYCLOAK_IDP_THIMISU_INSTAGRAM_APP_ID=trocar-instagram-app-id
KEYCLOAK_IDP_THIMISU_INSTAGRAM_APP_SECRET=trocar-instagram-app-secret
KEYCLOAK_IDP_THIMISU_X_CLIENT_ID=trocar-x-client-id
KEYCLOAK_IDP_THIMISU_X_CLIENT_SECRET=trocar-x-client-secret
KEYCLOAK_CLIENT_THIMISU_BACKEND_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_EICKRONO_AUTENTICACAO_INTERNO_SECRET=CHANGE_ME
KEYCLOAK_CLIENT_EICKRONO_KEYCLOAK_SECRET=CHANGE_ME

# Certificados mTLS (autoassinado)
MTLS_CERT_PATH=/certificados/eickrono-keycloak.p12
MTLS_CERT_SENHA=senhaCertificadoHml
MTLS_KEYSTORE_SENHA=senhaBackchannelHml
MTLS_TRUSTSTORE_SENHA=senhaBackchannelHml

# APIs
KEYCLOAK_PORT=19080
API_IDENTIDADE_PORT=19081
API_IDENTIDADE_MTLS_PORT=19681
API_CONTAS_PORT=19082
API_IDENTIDADE_DEBUG_PORT=5105
API_CONTAS_DEBUG_PORT=5106
THIMISU_API_MTLS_PORT=19683
OIDC_ISSUER_URI=http://127.0.0.1:19080/realms/eickrono
OIDC_JWKS_URI=http://host.docker.internal:19080/realms/eickrono/protocol/openid-connect/certs
EICKRONO_INTERNAL_SECRET=internalSecretHMLTrocar
INTEGRACAO_INTERNA_CLIENTE_AUTENTICACAO=autenticacao-servidor
IDENTIDADE_DEVICE_TOKEN_SECRET=hml-device-token-secret
IDENTIDADE_CODIGO_TOKEN_SECRET=hml-codigo-secret
IDENTIDADE_SESSAO_INTERNA_KEYCLOAK_CLIENT_ID=app-flutter-hml
IDENTIDADE_SESSAO_INTERNA_KEYCLOAK_CLIENT_SECRET=CHANGE_ME
EICKRONO_AUTENTICACAO_CLIENT_SECRET_INTERNO=CHANGE_ME
INTEGRACAO_IDENTIDADE_JWT_INTERNO_CLIENT_ID=autenticacao-servidor
INTEGRACAO_IDENTIDADE_JWT_INTERNO_CLIENT_SECRET=CHANGE_ME
INTEGRACAO_PERFIL_JWT_INTERNO_CLIENT_ID=autenticacao-servidor
INTEGRACAO_PERFIL_JWT_INTERNO_CLIENT_SECRET=CHANGE_ME
