COMPOSE_PROJECT_NAME=eickrono_autenticacao_stg

# Configuracoes do PostgreSQL por servico
KEYCLOAK_POSTGRES_HOST=host.docker.internal
KEYCLOAK_POSTGRES_PORT=5432
KEYCLOAK_POSTGRES_DB=keycloak_stg
KEYCLOAK_POSTGRES_USER=keycloak_stg
KEYCLOAK_POSTGRES_PASSWORD=senhaKeycloakStg

IDENTIDADE_POSTGRES_HOST=host.docker.internal
IDENTIDADE_POSTGRES_PORT=5432
IDENTIDADE_POSTGRES_DB=eickrono_identidade_stg
IDENTIDADE_POSTGRES_USER=eickrono_stg
IDENTIDADE_POSTGRES_PASSWORD=senhaSuperSeguraStg

CONTAS_POSTGRES_HOST=host.docker.internal
CONTAS_POSTGRES_PORT=5432
CONTAS_POSTGRES_DB=eickrono_contas_stg
CONTAS_POSTGRES_USER=eickrono_stg
CONTAS_POSTGRES_PASSWORD=senhaSuperSeguraStg

# Configuracoes do Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB=postgres
KC_PROXY=edge
KEYCLOAK_FEATURES=instagram-broker
EICKRONO_PASSWORD_PEPPER=pepperStagingTrocar
KEYCLOAK_FRONTEND_URL=http://localhost:18080

KEYCLOAK_IDP_THIMISU_GOOGLE_CLIENT_ID=trocar-google-client-id
KEYCLOAK_IDP_THIMISU_GOOGLE_CLIENT_SECRET=trocar-google-client-secret
KEYCLOAK_IDP_THIMISU_APPLE_CLIENT_ID=trocar-apple-client-id
KEYCLOAK_IDP_THIMISU_APPLE_CLIENT_SECRET_JWT=trocar-apple-client-secret-jwt
KEYCLOAK_IDP_THIMISU_FACEBOOK_APP_ID=trocar-facebook-app-id
KEYCLOAK_IDP_THIMISU_FACEBOOK_APP_SECRET=trocar-facebook-app-secret
KEYCLOAK_IDP_THIMISU_LINKEDIN_CLIENT_ID=trocar-linkedin-client-id
KEYCLOAK_IDP_THIMISU_LINKEDIN_CLIENT_SECRET=trocar-linkedin-client-secret
KEYCLOAK_IDP_THIMISU_INSTAGRAM_APP_ID=trocar-instagram-app-id
KEYCLOAK_IDP_THIMISU_INSTAGRAM_APP_SECRET=trocar-instagram-app-secret
KEYCLOAK_IDP_THIMISU_X_CLIENT_ID=trocar-x-client-id
KEYCLOAK_IDP_THIMISU_X_CLIENT_SECRET=trocar-x-client-secret

# Certificados mTLS (autoassinado)
MTLS_CERT_PATH=/certificados/eickrono-keycloak.p12
MTLS_CERT_SENHA=senhaCertificadoStg
MTLS_KEYSTORE_SENHA=senhaBackchannelStg
MTLS_TRUSTSTORE_SENHA=senhaBackchannelStg

# APIs
KEYCLOAK_PORT=18080
API_IDENTIDADE_PORT=18081
API_IDENTIDADE_MTLS_PORT=19481
API_CONTAS_PORT=18082
API_IDENTIDADE_DEBUG_PORT=5005
API_CONTAS_DEBUG_PORT=5006
THIMISU_API_MTLS_PORT=19483
OIDC_ISSUER_URI=http://localhost:18080/realms/eickrono
OIDC_JWKS_URI=http://host.docker.internal:18080/realms/eickrono/protocol/openid-connect/certs
EICKRONO_INTERNAL_SECRET=internalSecretStagingTrocar
IDENTIDADE_DEVICE_TOKEN_SECRET=stg-device-token-secret
IDENTIDADE_DEVICE_TOKEN_VALIDADE_HORAS=720
IDENTIDADE_OFFLINE_TEMPO_MAXIMO_MINUTOS=43200
IDENTIDADE_CODIGO_TOKEN_SECRET=stg-codigo-secret
IDENTIDADE_SESSAO_INTERNA_KEYCLOAK_CLIENT_ID=app-flutter-stg
