COMPOSE_PROJECT_NAME=eickrono_autenticacao

KEYCLOAK_POSTGRES_HOST=host.docker.internal
KEYCLOAK_POSTGRES_PORT=5432
KEYCLOAK_POSTGRES_DB=eickrono_dev
KEYCLOAK_POSTGRES_USER=eickrono
KEYCLOAK_POSTGRES_PASSWORD=senhaLocalDev

AUTENTICACAO_POSTGRES_HOST=host.docker.internal
AUTENTICACAO_POSTGRES_PORT=5432
AUTENTICACAO_POSTGRES_DB=eickrono_autenticacao
